# Geocoder. "nominatim" e' gratuito ma con limiti d'uso stringenti (1 richiesta al secondo,
# User-Agent identificabile obbligatorio): va bene per lo sviluppo, non per il traffico vero.
GEOCODER=nominatim
GEOCODER_UA="valmiro/0.1 (contatto: tua@email.it)"

# In produzione passa a un provider a consumo e metti qui la chiave.
# GEOCODER=tomtom
# TOMTOM_KEY=

# Opzionale: Postgres con PostGIS (Supabase o locale). Serve solo per npm run load-db,
# l'app funziona anche senza, leggendo i file in data/.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vaylo

# Account (Supabase). Senza queste due chiavi l'app funziona lo stesso: la pagina di
# accesso spiega che non e' ancora configurata, e le stime restano nel browser.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telemetria: attivare ENTRAMBI solo dopo migrazione, verifica permessi e job retention.
TELEMETRIA_ENABLED=false
NEXT_PUBLIC_TELEMETRIA_ENABLED=false
APP_ORIGIN=https://valmiro.it
# SUPABASE_SERVICE_ROLE_KEY=  # SEGRETO: mai prefisso NEXT_PUBLIC_
# APP_VERSION=commit-o-versione

# Termini: compilare dati reali del gestore e verificare il testo prima di pubblicare.
TERMINI_PUBBLICATI=false
# GESTORE_NOME=
# GESTORE_INDIRIZZO=
# GESTORE_EMAIL=
# GESTORE_PIVA=
